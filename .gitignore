# Hemligheter: API-nycklar och lösenord får aldrig hamna i repot.
# De sparas som miljövariabler i Cloudflare och lokalt i dessa filer.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key

# Beroenden och byggfiler (kan alltid återskapas)
node_modules/
dist/
build/
.vite/

# Cloudflare (lokala filer från Wrangler)
.wrangler/

# Lokala inställningar för Claude Code och MCP (kan innehålla nycklar)
.claude/settings.local.json
.mcp.json

# Loggar
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Editor- och systemfiler
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
